<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Equaly.ViewModels"
             x:Class="Equaly.Views.ExpensesPage"
             x:DataType="vm:ExpensesViewModel"
             BackgroundColor="#F8F9FA"
             Title="Harcamalar">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="16">

        <Label Grid.Row="0"
               Text="Harcamalar"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#2B2D42" />

        <Button Grid.Row="1"
                Text="+ Yeni Harcama"
                Command="{Binding AddNewExpenseCommand}"
                BackgroundColor="#4361EE"
                TextColor="White"
                CornerRadius="14"
                HeightRequest="48" />

        <RefreshView Grid.Row="2"
                     Command="{Binding LoadExpensesCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Expenses}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Henüz harcama yok"
                               TextColor="#ADB5BD"
                               FontSize="16"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExpenseListItem">
                        <Border Stroke="#DEE2E6"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="White"
                                Padding="16"
                                Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Description}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#2B2D42" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Amount, StringFormat='{0:0.##} TL'}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#4361EE" />

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding PayerName, StringFormat='Ödeyen: {0}'}"
                                       FontSize="13"
                                       TextColor="#6C757D" />

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="10"
                                      Margin="0,10,0,0">

                                    <Button Grid.Column="0"
                                            Text="Düzenle"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesViewModel}}, Path=EditExpenseCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F1F3F5"
                                            TextColor="#2B2D42"
                                            CornerRadius="10"
                                            HeightRequest="40"
                                            FontSize="13" />

                                    <Button Grid.Column="1"
                                            Text="Sil"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesViewModel}}, Path=DeleteExpenseCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FDEEEE"
                                            TextColor="#E74C3C"
                                            CornerRadius="10"
                                            HeightRequest="40"
                                            FontSize="13" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
