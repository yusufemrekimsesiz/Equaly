<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Equaly.ViewModels"
             xmlns:models="clr-namespace:Equaly.Models"
             xmlns:strings="clr-namespace:Equaly.Resources.Strings"
             x:Class="Equaly.Views.SettlementsPage"
             x:DataType="vm:SettlementsViewModel"
             BackgroundColor="#F8F9FA"
             Title="{x:Static strings:AppStrings.SettleUpNav}">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{x:Static strings:AppStrings.SettlementsTitle}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#2B2D42" />

            <Button Grid.Column="1"
                    Text="{x:Static strings:AppStrings.ShareSummary}"
                    Command="{Binding ShareSummaryCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#4361EE"
                    FontSize="13"
                    Padding="0"
                    VerticalOptions="Center" />
        </Grid>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadSettlementsCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Settlements}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="✓" FontSize="40" TextColor="#2ECC71" HorizontalOptions="Center" />
                        <Label Text="{x:Static strings:AppStrings.AllSettledUp}"
                               TextColor="#6C757D"
                               FontSize="16"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Settlement">
                        <Border Stroke="#DEE2E6"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="White"
                                Padding="16"
                                Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding DisplayText}"
                                       FontSize="16"
                                       TextColor="#2B2D42" />

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding FromLabelDisplay}"
                                       FontSize="12"
                                       TextColor="#E74C3C" />

                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Amount, StringFormat='{0:0.##} TL'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#4361EE" />

                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Text="{x:Static strings:AppStrings.MarkAsPaid}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettlementsViewModel}}, Path=MarkAsPaidCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#EAFBF1"
                                        TextColor="#2ECC71"
                                        CornerRadius="10"
                                        HeightRequest="40"
                                        FontSize="13"
                                        Margin="0,10,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
