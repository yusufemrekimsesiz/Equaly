<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Equaly.ViewModels"
             xmlns:models="clr-namespace:Equaly.Models"
             x:Class="Equaly.Views.AddExpensePage"
             x:DataType="vm:AddExpenseViewModel"
             BackgroundColor="#F8F9FA"
             Title="{Binding PageTitle}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              Padding="20"
              RowSpacing="16">

            <Label Grid.Row="0"
                   Text="{Binding PageTitle}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#2B2D42" />

            <!-- Ödeyen kişi -->
            <VerticalStackLayout Grid.Row="1" Spacing="6">
                <Label Text="Ödeyen Kişi" TextColor="#6C757D" FontSize="14" />
                <Border Stroke="#DEE2E6"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="12,0"
                        HeightRequest="50">
                    <Picker ItemsSource="{Binding People}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedPayer}"
                            TextColor="#2B2D42"
                            Title="Kişi seçin"
                            VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Tutar -->
            <VerticalStackLayout Grid.Row="2" Spacing="6">
                <Label Text="Tutar (TL)" TextColor="#6C757D" FontSize="14" />
                <Border Stroke="#DEE2E6"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="12,0"
                        HeightRequest="50">
                    <Entry Text="{Binding Amount}"
                           Placeholder="0.00"
                           Keyboard="Numeric"
                           TextColor="#2B2D42"
                           PlaceholderColor="#ADB5BD"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Açıklama -->
            <VerticalStackLayout Grid.Row="3" Spacing="6">
                <Label Text="Açıklama" TextColor="#6C757D" FontSize="14" />
                <Border Stroke="#DEE2E6"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="12,0"
                        HeightRequest="50">
                    <Entry Text="{Binding Description}"
                           Placeholder="Örn: Market alışverişi"
                           TextColor="#2B2D42"
                           PlaceholderColor="#ADB5BD"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Katılımcılar -->
            <VerticalStackLayout Grid.Row="4" Spacing="6">
                <Label Text="Katılımcılar (harcamayı kimler paylaşacak)" TextColor="#6C757D" FontSize="14" />
                <Border Stroke="#DEE2E6"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="4">
                    <CollectionView ItemsSource="{Binding People}"
                                     SelectionMode="Multiple"
                                     SelectedItems="{Binding SelectedParticipants, Mode=TwoWay}"
                                     HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Person">
                                <Grid Padding="12,10" ColumnDefinitions="Auto,*">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="White" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#E7ECFF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>

                                    <Label Grid.Column="0"
                                           Text="●"
                                           TextColor="#4361EE"
                                           FontSize="14"
                                           Margin="0,0,10,0"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextColor="#2B2D42"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!-- Hata mesajı -->
            <Label Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   TextColor="#E74C3C"
                   FontSize="13" />

            <!-- Kaydet butonu -->
            <Button Grid.Row="6"
                    Text="{Binding SaveButtonText}"
                    Command="{Binding SaveExpenseCommand}"
                    BackgroundColor="#4361EE"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="52" />

            <!-- İptal -->
            <Button Grid.Row="7"
                    Text="İptal"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#6C757D"
                    HeightRequest="44" />

        </Grid>
    </ScrollView>
</ContentPage>

